# Copy to `.env.local` and fill in real values. Do not commit `.env.local`.

# ── Convex ──────────────────────────────────────────────────────────────
# Created by `npx convex dev` (links this checkout to a deployment).
CONVEX_DEPLOYMENT=
# Public Convex endpoints (safe to expose to the browser).
PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=

# ── Clerk authentication ────────────────────────────────────────────────
# From https://dashboard.clerk.com → API Keys.
# Publishable key is read by the browser; secret key is server-only.
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where Clerk's <SignIn/> and <SignUp/> components are mounted (path routing).
PUBLIC_CLERK_SIGN_IN_URL=/sign-in
PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Clerk ↔ Convex JWT (set on the Convex deployment, NOT loaded from here) ─
# The issuer URL of Clerk's `convex` JWT template. Set it once with:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-instance>.clerk.accounts.dev
# CLERK_JWT_ISSUER_DOMAIN=https://<your-instance>.clerk.accounts.dev
